{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "MSYS Build",
			"type": "shell",
			"command": "cd \"$(cygpath '${workspaceFolder}')\" && make -j32",
			"options": {
				"env": {
					"MSYSTEM": "MINGW64"
				},
				"shell": {
					"executable": "C:/msys64/usr/bin/bash.exe",
					"args": [
						"-lc"
					]
				}
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"panel": "shared"
			},
			"problemMatcher": "$gcc"
		}
	]
}